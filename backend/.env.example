# Example only: DO NOT commit real API keys or secrets.
# Backend configuration. Keep provider credentials server-side.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# RPC_BSC=https://...
# RPC_ETHEREUM=https://...
# RPC_BASE=https://...
# RPC_ARBITRUM=https://...
# INDEXER_BSC=https://blockscout.routescan.io/56/api/v2
# INDEXER_ETHEREUM=https://eth.blockscout.com/api/v2
# INDEXER_BASE=https://base.blockscout.com/api/v2
# INDEXER_ARBITRUM=https://arbitrum.blockscout.com/api/v2
APPROVAL_LOG_LOOKBACK_BLOCKS=2500
MAX_TOKEN_PAGES=2
MAX_TX_PAGES=2

# If you use https://api.blockscout.com/<chain_id>/api/v2, set a server-side key:
# BLOCKSCOUT_API_KEY=YOUR_SERVER_SIDE_API_KEY
# Optional: richer token discovery and prices, especially on BSC (server-side only)
# MORALIS_API_KEY=YOUR_SERVER_SIDE_MORALIS_API_KEY
